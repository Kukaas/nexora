DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nexora_v2?schema=public

BETTER_AUTH_SECRET=khSDlVDJlPbf4hJ0oWQyrHHVghuHDnlm
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Public base URL of the site, used for canonical URLs, sitemap.xml, robots.txt,
# and Open Graph/JSON-LD. Set this to the production domain (e.g.
# https://nexora.ph). Falls back to NEXT_PUBLIC_BETTER_AUTH_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (optional). When both are set, "Continue with Google" on the
# sign-in page becomes active. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (used by nodemailer for verification and password-reset emails)
# Works with any provider: Mailtrap, Gmail (app password), SES, Resend SMTP, ...
# Port 465 = implicit TLS, anything else (587) = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nexora <no-reply@nexora.local>"

# Cloudinary (signed, server-side uploads for payment QR codes and ID images).
# All three are required for uploads to work; leave blank to disable them.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
