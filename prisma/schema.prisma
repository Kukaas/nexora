// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                              String            @id @default(uuid())
  name                            String?           @map("name")
  firstName                       String?           @map("first_name")
  middleName                      String?           @map("middle_name")
  lastName                        String?           @map("last_name")
  email                           String
  image                           String?
  birthDate                       DateTime?         @map("birth_date")
  mobileNumber                    String?           @map("mobile_number")
  profileCompletedAt              DateTime?         @map("profile_completed_at")
  mustChangePassword              Boolean           @default(false) @map("must_change_password")

  emailVerified                   Boolean           @default(false) @map("email_verified")
  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @updatedAt @map("updated_at")

  sessions                        Session[]
  accounts                        Account[]
  roles                           UserRoles[]       @default([RESIDENT]) @map("roles")
  ids                             ID[]

  payments                        Payment[]         @relation("PaymentPayer")
  reviewedPayments                Payment[]         @relation("PaymentReviewer")
  updatedPaymentMethods           PaymentMethod[]   @relation("PaymentMethodEditor")

  documentRequests                DocumentRequest[] @relation("DocumentRequester")
  reviewedDocumentRequests        DocumentRequest[] @relation("DocumentReviewer")
  updatedDocumentTypes            DocumentType[]    @relation("DocumentTypeEditor")
  announcements                   Announcement[]    @relation("AnnouncementAuthor")

  @@unique([email])
  @@map("user")
}

model Session {
  id                              String            @id @default(uuid())
  token                           String
  ipAddress                       String?           @map("ip_address")
  userAgent                       String?           @map("user_agent")

  userId                          String            @map("user_id")

  user                            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt                       DateTime          @map("expires_at")
  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @updatedAt @map("updated_at")

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                              String            @id @default(uuid())
  scope                           String?           @map("scope")
  password                        String?           @map("password")
  accessToken                     String?           @map("access_token")
  refreshToken                    String?           @map("refresh_token")
  idToken                         String?           @map("id_token")

  accountId                       String            @map("account_id")
  providerId                      String            @map("provider_id")
  userId                          String            @map("user_id")

  user                            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessTokenExpiresAt            DateTime?         @map("access_token_expires_at")
  refreshTokenExpiresAt           DateTime?         @map("refresh_token_expires_at")
  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id                              String            @id @default(uuid())
  identifier                      String
  value                           String

  expiresAt                       DateTime          @map("expires_at")
  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model ID {
  id                              String            @id @default(uuid())
  type                            IDType
  number                          String
  frontImage                      String            @map("front_image")
  backImage                       String?           @map("back_image")
  status                          IDStatus          @default(PENDING)
  reviewedAt                      DateTime?         @map("reviewed_at")

  userId                          String            @map("user_id")
  user                            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @updatedAt @map("updated_at")

  @@unique([type, number])
  @@index([userId])
  @@map("id")
}

model PaymentMethod {
  id                              String            @id @default(uuid())
  type                            PaymentMethodType
  enabled                         Boolean           @default(false)

  accountName                     String?           @map("account_name")
  accountNumber                   String?           @map("account_number")
  qrImage                         String?           @map("qr_image")

  instructions                    String?

  updatedById                     String?           @map("updated_by_id")
  updatedBy                       User?             @relation("PaymentMethodEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @updatedAt @map("updated_at")

  @@unique([type])
  @@map("payment_method")
}

model Payment {
  id                              String            @id @default(uuid())
  purpose                         String
  amount                          Decimal           @db.Decimal(10, 2)
  method                          PaymentMethodType
  referenceNumber                 String?           @map("reference_number")
  proofImage                      String?           @map("proof_image")

  status                          PaymentStatus     @default(PENDING)
  reviewNote                      String?           @map("review_note")

  payerId                         String            @map("payer_id")
  payer                           User              @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Cascade)
  payerName                       String            @map("payer_name")

  reviewedById                    String?           @map("reviewed_by_id")
  reviewedBy                      User?             @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                      DateTime?         @map("reviewed_at")

  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([payerId])
  @@map("payment")
}

model DocumentType {
  id                               String           @id @default(uuid())
  name                             String
  description                      String?
  fee                              Decimal          @db.Decimal(10, 2)
  turnaroundDays                   Int              @default(2) @map("turnaround_days")
  active                           Boolean          @default(true)

  fields                           Json             @default("[]")
  template                         String?          @db.Text
  paperSize                        String           @default("A4") @map("paper_size")
  orientation                      String           @default("portrait")

  requests                         DocumentRequest[]

  updatedById                      String?          @map("updated_by_id")
  updatedBy                        User?            @relation("DocumentTypeEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @updatedAt @map("updated_at")

  @@unique([name])
  @@map("document_type")
}

model DocumentRequest {
  id                               String           @id @default(uuid())
  referenceNumber                  String           @map("reference_number")

  documentTypeId                   String?          @map("document_type_id")
  documentType                     DocumentType?    @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  documentName                     String           @map("document_name")
  fee                              Decimal          @db.Decimal(10, 2)

  fieldValues                      Json             @default("[]") @map("field_values")

  purpose                          String?

  method                           PaymentMethodType
  paymentReference                 String?          @map("payment_reference")
  proofImage                       String?          @map("proof_image")
  orNumber                         String?          @map("or_number")

  status                           DocumentRequestStatus @default(PENDING)
  note                             String?
  resubmitNote                     String?          @map("resubmit_note")

  requesterId                      String           @map("requester_id")
  requester                        User             @relation("DocumentRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterName                    String           @map("requester_name")

  reviewedById                     String?          @map("reviewed_by_id")
  reviewedBy                       User?            @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                       DateTime?        @map("reviewed_at")
  releasedAt                       DateTime?        @map("released_at")

  createdAt                        DateTime         @default(now()) @map("created_at")
  updatedAt                        DateTime         @updatedAt @map("updated_at")

  @@unique([referenceNumber])
  @@index([status])
  @@index([requesterId])
  @@map("document_request")
}

model MediaAsset {
  id                               String            @id @default(uuid())
  url                              String
  name                             String
  createdById                      String?           @map("created_by_id")
  createdAt                        DateTime          @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("media_asset")
}

model Announcement {
  id                               String            @id @default(uuid())
  title                            String
  body                             String
  category                         AnnouncementCategory  @default(ADVISORY)
  pinned                           Boolean           @default(false)
  published                        Boolean           @default(true)
  place                            String?
  latitude                         Float?            @map("latitude")
  longitude                        Float?            @map("longitude")
  date                             DateTime?         @map("date")
  startTime                        String?           @map("start_time")
  endTime                          String?           @map("end_time")
  imageUrl                         String?           @map("image_url")

  authorId                         String?           @map("author_id")
  author                           User?             @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt                        DateTime          @default(now()) @map("created_at")
  updatedAt                        DateTime          @updatedAt @map("updated_at")

  @@index([published, pinned])
  @@map("announcement")
}

enum DocumentRequestStatus {
  PENDING
  PROCESSING
  READY
  CLAIMED
  REJECTED
}

enum AnnouncementCategory {
  ADVISORY
  HEALTH
  EVENTS
  ASSISTANCE
  GOVERNANCE
}

enum UserRoles {
  ADMIN
  CAPTAIN
  SECRETARY
  TREASURER
  KAGAWAD
  RESIDENT
}

enum IDType {
  DRIVER_LICENSE
  PASSPORT
  SSS
  GSIS
  PRC
  OTHERS
}

enum IDStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethodType {
  GCASH
  MAYA
  CASH
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}
